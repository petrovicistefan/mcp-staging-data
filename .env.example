# Source is read-only. Prefer a Postgres role with SELECT-only grants.
STAGING_DATA_SOURCE_URL=postgres://readonly:secret@127.0.0.1:5432/prod_copy

# Target must not be the same host+port+database as source (localhost ≡ 127.0.0.1).
STAGING_DATA_TARGET_URL=postgres://dev:secret@127.0.0.1:5432/staging

# Local secret for deterministic HMAC pseudonyms. Never commit the real value.
STAGING_DATA_HMAC_KEY=replace-with-a-long-random-string

# Optional. Defaults to ./staging-data.rules.json
# STAGING_DATA_RULES_PATH=staging-data.rules.json
